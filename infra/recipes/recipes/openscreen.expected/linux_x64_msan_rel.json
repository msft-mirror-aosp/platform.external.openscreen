    "infra_step": true,
    "luci_context": {
      "realm": {
        "name": "openscreen:try"
      },
      "resultdb": {
        "current_invocation": {
          "name": "invocations/build:8945511751514863184",
          "update_token": "token"
        },
        "hostname": "rdbhost"
